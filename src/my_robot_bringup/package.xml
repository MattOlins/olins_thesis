<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>my_robot_bringup</name>
  <version>0.0.0</version>
  <description>Bringup package for four-wheel skid-steer VFH thesis robot</description>
  <maintainer email="olinsmatt@gmail.com">kalgaonp</maintainer>
  <license>Apache-2.0</license>

  <!--build system -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!--ROS2 launch infrastructure -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!--robot and tf publisher -->
  <exec_depend>robot_state_publisher</exec_depend>

  <!--gazebo = -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!--SLAM/mapping  -->
  <exec_depend>slam_toolbox</exec_depend>

  <!-- Visualization -->
  <exec_depend>rviz2</exec_depend>

  <!-- test depandencies  -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- Package Export -->
  <export>
    <build_type>ament_python</build_type>
  </export>

</package>