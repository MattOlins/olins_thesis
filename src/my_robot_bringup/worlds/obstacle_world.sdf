<?xml version="1.0"?>
<sdf version="1.8">
    <world name="vfh_world">

        <!-- Physics information -->
        <physics name="default_physics" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>

        <!-- Allows ROS/Gazebo to insert the robot -->
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

        <!-- Publishes the simulation scene -->
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

        <!-- Required for the simulated LiDAR -->
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <!--define gravity -->
        <gravity>0 0 -9.81</gravity>

        <!-- Ground plane -->
        <model name="ground_plane">
            <static>true</static>

            <link name="ground">
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>30 30</size>
                        </plane>
                    </geometry>
                </visual>
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>30 30</size>
                        </plane>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>1.0</mu>
                                <mu2>1.0</mu2>
                            </ode>
                        </friction>
                    </surface>
                </collision>
            </link>
        </model>

        <!-- An obstacle 2 meters in front of the robot -->
        <model name="obstacle_1">
            <static>true</static>

            <pose>2 0 0.5 0 0 0</pose> <!-- pose tag: x y z roll pitch yaw -->

            <link name="body">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.7 0.6 1</ambient>
                        <diffuse>0.5 0.7 0.6 1</diffuse>
                    </material>
                </visual>

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1.0</size>
                        </box>
                    </geometry>
                </collision>
            </link>
        </model>

        <!-- A second obstacle offset from the robot -->
        <model name="obstacle_2">
            <static>true</static>

            <pose>3.5 1.0 0.5 0 0 0</pose>

            <link name="body">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.7 0.6 1</ambient>
                        <diffuse>0.5 0.7 0.6 1</diffuse>
                    </material>
                </visual>

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1.0</size>
                        </box>
                    </geometry>
                </collision>
            </link>
        </model>

        <!-- third obstacle -->
        <model name="obstacle_3">
            <static>true</static>

            <pose>2 -1.0 0.5 0 0 0</pose>

            <link name="body">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.7 0.6 1</ambient>
                        <diffuse>0.5 0.7 0.6 1</diffuse>
                    </material>
                </visual>

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1.0</size>
                        </box>
                    </geometry>
                </collision>
            </link>
        </model>

        <!--Adding walls around world-->
                <!-- North wall -->
        <model name="north_wall">
            <static>true</static>
            <pose>0 5 0.5 0 0 0</pose>
            <link name="wall">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>10 0.2 1.0</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>10 0.2 1.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- South wall -->
        <model name="south_wall">
            <static>true</static>
            <pose>0 -5 0.5 0 0 0</pose>
            <link name="wall">
                <collision name="collision">
                <geometry>
                    <box>
                    <size>10 0.2 1.0</size>
                    </box>
                </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>10 0.2 1.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- East wall -->
        <model name="east_wall">
            <static>true</static>
            <pose>5 0 0.5 0 0 0</pose>
            <link name="wall">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 10 1.0</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 10 1.0</size>
                        </box>
                    </geometry>
                    <material>
                            <ambient>0.6 0.6 0.6 1</ambient>
                            <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- West wall -->
        <model name="west_wall">
            <static>true</static>
            <pose>-5 0 0.5 0 0 0</pose>
            <link name="wall">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 10 1.0</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 10 1.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

    </world>

</sdf>